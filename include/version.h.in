#pragma once

#include <string_view>

namespace Config {
    inline constexpr std::string_view APP_NAME = "@PROJECT_NAME@";
    inline constexpr std::string_view VERSION = "@PROJECT_VERSION@";
    inline constexpr int VERSION_MAJOR = @PROJECT_VERSION_MAJOR@;
    inline constexpr int VERSION_MINOR = @PROJECT_VERSION_MINOR@;
    inline constexpr int VERSION_PATCH = @PROJECT_VERSION_PATCH@;
    inline constexpr std::string_view HOMEPAGE = "@PROJECT_HOMEPAGE@";
    inline constexpr std::string_view BUILD_TYPE = "@CMAKE_BUILD_TYPE@";
    inline constexpr std::string_view BUILD_DATE = "@BUILD_DATE@";
    inline constexpr std::string_view BUILD_TIME = "@BUILD_TIME@";

    inline constexpr bool IS_DEBUG = 
    #ifdef NDEBUG
        false;
    #else
        true;
    #endif
}
